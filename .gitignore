
# gitignore has no quoting syntax. This line used to carry the pattern in
# double quotes, which matches a filename containing the quote characters, so
# the dump was never excluded and stayed tracked. Untracked in the same commit;
# the working copy stays on disk.
backup_fintrack.sql

.vscode/

# ===============================
# 📦 DEPENDENCIES
# ===============================
node_modules/

# ===============================
# ⚡ BUILD OUTPUT
# ===============================
dist/
build/
.vercel/

# ===============================
# 🧪 TESTING
# ===============================
coverage/

# ===============================
# ⚙️ ENV FILES (SENSIBLE)
# ===============================
.env
.env.*
# Applies to root-level files only. backend/ and frontend/ carry their own
# .gitignore, and the deepest matching file wins — each needs its own negation.
!.env.example

# ===============================
# 🧠 LOGS
# ===============================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 🧠 DIFF FILE
# ==========
diff.md

# ===============================
# 🖥️ OS FILES
# ===============================
.DS_Store
Thumbs.db

# ===============================
# 🧰 EDITORS / IDE
# ===============================
.vscode/
.idea/
*.swp
*.swo

# ===============================
# 🔒 TYPESCRIPT
# ===============================
*.tsbuildinfo

# ===============================
# 🧪 CACHE / TEMP
# ===============================
.cache/
.temp/
.tmp/
.eslintcache

# ===============================
# ⚡ VITE
# ===============================
vite.svg

# ===============================
# 🚀 OPTIONAL (if you generate locally)
# ===============================
storybook-static/

# ===============================
# 🔐 CERTS / KEYS (just in case)
# ===============================
*.pem
*.crt
*.cert
*.key
.vercel
.env*.local

# ===============================
#🧪 SCRIPTS
# ===============================
SCRIPTS
scripts/
# Never matched anything: the same quoting mistake as above, and it misspells
# backend. Kept commented rather than removed until its intent is confirmed.
# *scripts"backen/.gitignore"

# backend/scripts/ holds development tooling, not scratch files. The rule above
# is a bare directory name, so it matches at any depth and swallowed this
# folder. A negation on the file alone would not work: git does not re-include a
# path inside an excluded directory, so the directory has to be re-included
# first.
!backend/scripts/
!backend/scripts/**

# ===============================
# 🌿 AGENT WORKTREES
# ===============================
# Isolated git worktrees a session may create to work off the branch. They are
# a scratch checkout of this same repository, never source.
.claude/worktrees/

# =============================
#plan docs
#
# Excluded outright, no re-includes. Decided 2026-09-16, reversing the
# 2026-09-03 correction that tracked ongoing/, business-rules/, completed/
# and mockups/: the whole tree holds operational material beside the
# planning notes — probes that read a production connection string out of
# .env, deployment guides that name the certificate — and versioning any of
# it puts access tooling in the history, where deleting it later does not
# remove it. Nothing under plan-docs/ produces a commit; work there is
# local-only.
plan-docs/*

# =============================
# docs/ - extended 2026-09-16 from docs/VIDEO/ alone (PLAN_PROMO_VIDEO.md, Q7)
# to the whole folder, on Carlos's own instruction. Raw captures, intermediate
# scene clips, and rendered MP4s under docs/VIDEO/ are large binary output, not
# source - the final MP4 that ships is uploaded to the README as a GitHub
# attachment (its own CDN URL), never committed here. docs/budget/,
# docs/charts/ and docs/design-system/ each already carry one tracked .md;
# this rule does not untrack them (git still diffs a file it already tracks
# regardless of .gitignore) - it only stops any new file added under docs/
# from being picked up by a future "git add .".
docs/
# Crash dumps left behind when the Git Bash shell faults. Junk, and a hazard
# in a tree several sessions commit from: one careless "git add ." sweeps it in.
*.stackdump
