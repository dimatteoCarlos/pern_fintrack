# frontend/.env.example
#
# Copy to frontend/.env.local and fill in.
# Every value here is intentionally blank.
#
# SECURITY: Vite inlines every VITE_-prefixed variable into the built bundle.
# Anything below ships to the browser and is readable by anyone who opens
# devtools. Never put an API key, token, or database credential in this file —
# a secret that reaches the client is a published secret. Values that must stay
# private belong in backend/.env and are reached through the API.

# development | production
VITE_ENVIRONMENT=

# Base URL of the backend API, e.g. http://localhost:5000/api
VITE_API_BASE_URL=

# Auth routes base URL, e.g. http://localhost:5000/api/auth
VITE_API_BASE_URL_AUTH=

# Fintrack application routes base URL, e.g. http://localhost:5000/api/fintrack
VITE_API_URL_APP=

# How far back a calendar offers an operative date, in whole calendar months
# counting the current one. 1 is the current month alone; 2 also opens the
# previous month. Absent or unreadable falls back to 2.
# This mirrors BACKDATING_WINDOW_MONTHS in backend/.env, which is the window
# actually enforced; both have to be set to the same number.
VITE_BACKDATING_WINDOW_MONTHS=
