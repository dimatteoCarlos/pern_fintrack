# backend/.env.example
#
# Copy to backend/.env and fill in.
# Every value here is intentionally blank. Never commit a real credential.
# Comments sit on their own line: dotenv's handling of trailing comments
# depends on quoting, so keeping them separate avoids surprises.

# ===============================
# RUNTIME
# ===============================
# development | production
NODE_ENV=
# e.g. 5000
PORT=
# Frontend origin allowed by CORS, e.g. http://localhost:5173
CLIENT_URL=

# ===============================
# DATABASE
# ===============================
# Active connection string: postgres://user:password@host:port/database
DATABASE_URI=
# Max pool connections. Keep low on serverless — each warm instance holds its own pool.
DB_POOL_MAX=
# true | false
DB_SSL=

# Required when DB_SSL=true. The app refuses to start without it rather than
# connecting unverified — see src/db/config/dbEnvironmentConfig.js.
# Base64 of the provider CA certificate, single line.
# Base64 is used because it survives every env-var transport (Vercel dashboard,
# dotenv, CI stores, shell exports) without newline mangling.
DB_CA_CERT_B64=
# Legacy fallback, raw PEM. Prefer DB_CA_CERT_B64.
DB_CA_CERT=

# --- Inactive presets -----------------------------------------------------
# Not read by any code. They exist so you can keep both connection profiles
# side by side and paste the one you want into the active variables above.
DATABASE_URI_LOCAL=
DATABASE_URI_SUPABASE=
DB_SSL_DEV=
DB_SSL_PROD=
DB_POOL_MAX_DEV=
DB_POOL_MAX_PROD=
NODE_ENV_DEV=
NODE_ENV_PROD=

# ===============================
# AUTH
# ===============================
JWT_SECRET=
JWT_REFRESH_TOKEN_SECRET=
# bcrypt cost factor, e.g. 10
SALT_ROUNDS=

# ===============================
# LEDGER
# ===============================
# How far back a movement or an account opening may be dated, in whole calendar
# months counting the current one. 1 is the current month alone; 2 also opens
# the previous month. Absent or unreadable falls back to 2.
# The calendar mirrors this through VITE_BACKDATING_WINDOW_MONTHS in the
# frontend; both have to be set to the same number.
BACKDATING_WINDOW_MONTHS=

# ===============================
# FX / CURRENCY
# ===============================
# ISO 4217 code used as the accounting currency, e.g. USD
ACCOUNTING_CURRENCY_CODE=
EXCHANGE_RATE_API_KEY=
FREE_CURRENCY_API_KEY=
API_KEY_COTIZAVE=
FX_REQUEST_TIMEOUT_MS=
FX_CACHE_TTL_HOURS=
FX_CACHE_TTL_MS=
FX_GITHUB_TTL_HOURS=
FX_STATIC_FALLBACK_TTL_HOURS=
# true | false
RESET_EXCHANGE_RATES=

# ===============================
# OPS
# ===============================
# Shared secret expected by the cron endpoints
CRON_SECRET=
SYSTEM_ADMIN_EMAIL=
# true | false
SEED_ADMIN=

# ===============================
# INJECTED BY THE PLATFORM — do not set locally
# ===============================
# VERCEL — set automatically on Vercel. src/app.js skips dotenv.config() when present.
